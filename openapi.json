{
	"openapi": "3.0.3",
	"info": {
		"title": "Project Manager",
		"version": "1.0.0",
		"description": "Token-friendly OCS API for the Project Manager Nextcloud app. Every operation the web UI can do is also available here, meant for external/automated clients (scripts, AI agents pairing with a user, etc.) authenticated with a Nextcloud app password (Settings > Security > Create new app password) via HTTP Basic Auth. Every request must also carry the `OCS-APIRequest: true` header, per the standard Nextcloud OCS API convention."
	},
	"servers": [
		{
			"url": "https://{host}/ocs/v2.php/apps/projectmanager",
			"description": "Base path on any Nextcloud instance running this app. Replace {host} with the instance's domain.",
			"variables": {
				"host": { "default": "your-nextcloud.example.com" }
			}
		}
	],
	"security": [{ "basicAuth": [] }],
	"components": {
		"securitySchemes": {
			"basicAuth": {
				"type": "http",
				"scheme": "basic",
				"description": "Nextcloud username + app password (NOT the account password). Generate one in Settings > Security > Devices & sessions > Create new app password."
			}
		},
		"parameters": {
			"OcsApiRequest": {
				"name": "OCS-APIRequest",
				"in": "header",
				"required": true,
				"schema": { "type": "string", "enum": ["true"] },
				"description": "Required by all Nextcloud OCS endpoints."
			}
		},
		"schemas": {
			"Project": {
				"type": "object",
				"properties": {
					"id": { "type": "integer" },
					"userId": { "type": "string" },
					"name": { "type": "string" },
					"hoursPerWorkingDay": { "type": "number", "format": "float", "default": 7 },
					"createdAt": { "type": "string", "format": "date-time", "nullable": true },
					"hourlyRate": { "type": "number", "format": "float", "nullable": true, "description": "Optional hourly rate; when set together with showCostInSummary, the grid summary includes a computed cost column" },
					"currencySymbol": { "type": "string", "default": "€", "description": "Shown after the cost value, e.g. \"350.00 €\"" },
					"showCostInSummary": { "type": "boolean", "default": false },
					"archived": { "type": "boolean", "default": false, "description": "Archived projects are hidden from the default project list but keep all their data" },
					"clientId": { "type": "integer", "nullable": true, "description": "Optional client this project belongs to, see /api/v1/clients" }
				}
			},
			"Client": {
				"type": "object",
				"properties": {
					"id": { "type": "integer" },
					"userId": { "type": "string" },
					"name": { "type": "string" },
					"createdAt": { "type": "string", "format": "date-time", "nullable": true },
					"hourlyRate": { "type": "number", "format": "float", "nullable": true, "description": "Default hourly rate used by this client's projects unless a project sets its own" },
					"currencySymbol": { "type": "string", "default": "€", "description": "This client's projects always use this currency, regardless of any currency set on the project itself" }
				}
			},
			"Module": {
				"type": "object",
				"properties": {
					"id": { "type": "integer" },
					"projectId": { "type": "integer" },
					"code": { "type": "string" },
					"name": { "type": "string" },
					"inEstimate": { "type": "boolean", "description": "true = counts toward the estimate (P1-P4 style); false = OTHERS, done but outside scope" },
					"sortOrder": { "type": "integer" }
				}
			},
			"Point": {
				"type": "object",
				"properties": {
					"id": { "type": "integer" },
					"moduleId": { "type": "integer" },
					"code": { "type": "string" },
					"description": { "type": "string" },
					"estimateH": { "type": "number", "format": "float", "nullable": true, "description": "null means no estimate (typically OTHERS points)" },
					"status": { "type": "string", "enum": ["todo", "in_progress", "partial", "done"] },
					"sortOrder": { "type": "integer" }
				}
			},
			"Leaf": {
				"type": "object",
				"properties": {
					"id": { "type": "integer" },
					"pointId": { "type": "integer" },
					"description": { "type": "string" },
					"workDate": { "type": "string", "format": "date" },
					"sortOrder": { "type": "integer" }
				}
			},
			"DayHours": {
				"type": "object",
				"properties": {
					"id": { "type": "integer" },
					"projectId": { "type": "integer" },
					"workDate": { "type": "string", "format": "date" },
					"hours": { "type": "number", "format": "float" }
				}
			},
			"Feature": {
				"type": "object",
				"properties": {
					"id": { "type": "integer" },
					"projectId": { "type": "integer" },
					"section": { "type": "string" },
					"name": { "type": "string" },
					"pointRef": { "type": "string" },
					"status": { "type": "string", "enum": ["not_started", "in_progress", "done"] },
					"businessValue": { "type": "string" },
					"externalPending": { "type": "string" },
					"sortOrder": { "type": "integer" }
				}
			},
			"TestEntry": {
				"type": "object",
				"properties": {
					"id": { "type": "integer" },
					"projectId": { "type": "integer" },
					"area": { "type": "string" },
					"profile": { "type": "string" },
					"scenario": { "type": "string" },
					"expected": { "type": "string" },
					"status": { "type": "string", "enum": ["to_test", "passed", "failed"] },
					"testDate": { "type": "string", "format": "date", "nullable": true },
					"notes": { "type": "string" },
					"sortOrder": { "type": "integer" }
				}
			},
			"PointGrid": {
				"allOf": [
					{ "$ref": "#/components/schemas/Point" },
					{
						"type": "object",
						"properties": {
							"doneH": { "type": "number", "format": "float" },
							"remainingH": { "type": "number", "format": "float", "nullable": true },
							"pctByDay": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "day (YYYY-MM-DD) -> integer percentage of that day's hours spent on this point" },
							"leaves": { "type": "array", "items": { "$ref": "#/components/schemas/Leaf" } }
						}
					}
				]
			},
			"ModuleGrid": {
				"allOf": [
					{ "$ref": "#/components/schemas/Module" },
					{
						"type": "object",
						"properties": {
							"estimateH": { "type": "number", "format": "float", "nullable": true },
							"doneH": { "type": "number", "format": "float" },
							"remainingH": { "type": "number", "format": "float", "nullable": true },
							"pctByDay": { "type": "object", "additionalProperties": { "type": "integer" } },
							"points": { "type": "array", "items": { "$ref": "#/components/schemas/PointGrid" } }
						}
					}
				]
			},
			"ProjectGrid": {
				"type": "object",
				"description": "The fully computed project grid: modules -> points -> leaves, with estimate/done/remaining hours, per-day percentages (largest-remainder split) and the project-level summary. Returned by GET /api/v1/projects/{id}.",
				"properties": {
					"project": {
						"type": "object",
						"properties": {
							"id": { "type": "integer" },
							"name": { "type": "string" },
							"hoursPerWorkingDay": { "type": "number", "format": "float" },
							"hourlyRate": { "type": "number", "format": "float", "nullable": true, "description": "This project's own rate override, if any. Null means it inherits the client's rate (see effectiveHourlyRate)." },
							"currencySymbol": { "type": "string", "description": "This project's own currency, used only when it has no client" },
							"effectiveHourlyRate": { "type": "number", "format": "float", "nullable": true, "description": "The rate actually used for cost calculations: this project's hourlyRate, or its client's if unset" },
							"effectiveCurrencySymbol": { "type": "string", "description": "The currency actually used: the client's currency when the project has one, otherwise this project's own currencySymbol" },
							"showCostInSummary": { "type": "boolean" },
							"archived": { "type": "boolean" },
							"clientId": { "type": "integer", "nullable": true }
						}
					},
					"days": { "type": "array", "items": { "type": "string", "format": "date" }, "description": "ordered list of days that have logged hours and/or leaves" },
					"hoursByDay": { "type": "object", "additionalProperties": { "type": "number", "format": "float" } },
					"modules": { "type": "array", "items": { "$ref": "#/components/schemas/ModuleGrid" } },
					"totalPctByDay": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "should read ~100 on any day with logged leaves" },
					"summary": {
						"type": "object",
						"properties": {
							"estimatedH": { "type": "number", "format": "float" },
							"estimatedDays": { "type": "number", "format": "float" },
							"estimatedCost": { "type": "number", "format": "float", "nullable": true },
							"doneInScopeH": { "type": "number", "format": "float" },
							"doneInScopeDays": { "type": "number", "format": "float" },
							"doneInScopeCost": { "type": "number", "format": "float", "nullable": true },
							"doneOthersH": { "type": "number", "format": "float" },
							"doneOthersDays": { "type": "number", "format": "float" },
							"doneOthersCost": { "type": "number", "format": "float", "nullable": true },
							"doneTotalH": { "type": "number", "format": "float" },
							"doneTotalDays": { "type": "number", "format": "float" },
							"doneTotalCost": { "type": "number", "format": "float", "nullable": true },
							"remainingH": { "type": "number", "format": "float" },
							"remainingDays": { "type": "number", "format": "float" },
							"remainingCost": { "type": "number", "format": "float", "nullable": true },
							"costEnabled": { "type": "boolean" },
							"currencySymbol": { "type": "string" }
						}
					}
				}
			}
		}
	},
	"paths": {
		"/api/v1/help": {
			"get": {
				"operationId": "help",
				"summary": "Human/AI-readable quick reference: what this API does, how to authenticate, and a condensed list of every endpoint. No authentication required — start here.",
				"security": [],
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/api/v1/projects": {
			"get": {
				"operationId": "listProjects",
				"summary": "List all projects owned by the authenticated user",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "includeArchived", "in": "query", "required": false, "schema": { "type": "boolean", "default": false }, "description": "When true, archived projects are included in the results alongside active ones" }],
				"responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } } } } } }
			},
			"post": {
				"operationId": "createProject",
				"summary": "Create a new project",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }],
				"requestBody": {
					"required": true,
					"content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "hoursPerWorkingDay": { "type": "number", "default": 7 }, "clientId": { "type": "integer", "nullable": true } } } } }
				},
				"responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } } }
			}
		},
		"/api/v1/clients": {
			"get": {
				"operationId": "listClients",
				"summary": "List all clients owned by the authenticated user",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }],
				"responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Client" } } } } } }
			},
			"post": {
				"operationId": "createClient",
				"summary": "Create a new client",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }],
				"requestBody": {
					"required": true,
					"content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } } } }
				},
				"responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Client" } } } } }
			}
		},
		"/api/v1/clients/{id}": {
			"get": {
				"operationId": "getClient",
				"summary": "Get a client with its aggregated summary (estimated/done/remaining hours and, where enabled, cost — summed across all its projects) and a per-project breakdown",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"client": { "$ref": "#/components/schemas/Client" },
										"currencySymbol": { "type": "string" },
										"costEnabled": { "type": "boolean", "description": "true if at least one of the client's projects has cost enabled" },
										"totals": {
											"type": "object",
											"properties": {
												"estimatedH": { "type": "number", "format": "float" },
												"estimatedCost": { "type": "number", "format": "float" },
												"doneInScopeH": { "type": "number", "format": "float" },
												"doneInScopeCost": { "type": "number", "format": "float" },
												"doneOthersH": { "type": "number", "format": "float" },
												"doneOthersCost": { "type": "number", "format": "float" },
												"doneTotalH": { "type": "number", "format": "float" },
												"doneTotalCost": { "type": "number", "format": "float" },
												"remainingH": { "type": "number", "format": "float" },
												"remainingCost": { "type": "number", "format": "float" }
											}
										},
										"projects": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"id": { "type": "integer" },
													"name": { "type": "string" },
													"archived": { "type": "boolean" },
													"summary": { "type": "object", "description": "same shape as ProjectGrid.summary" }
												}
											}
										}
									}
								}
							}
						}
					},
					"404": { "description": "Not found" }
				}
			},
			"put": {
				"operationId": "updateClient",
				"summary": "Rename a client, or set its default hourlyRate/currencySymbol. Its projects inherit hourlyRate unless they set their own, and always use its currencySymbol.",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
				"requestBody": {
					"content": {
						"application/x-www-form-urlencoded": {
							"schema": {
								"type": "object",
								"properties": {
									"name": { "type": "string" },
									"hourlyRate": { "type": "number", "nullable": true, "description": "only applied when hourlyRateProvided=true, so it can be explicitly cleared to null" },
									"hourlyRateProvided": { "type": "boolean", "default": false },
									"currencySymbol": { "type": "string" }
								}
							}
						}
					}
				},
				"responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Client" } } } }, "404": { "description": "Not found" } }
			},
			"delete": {
				"operationId": "deleteClient",
				"summary": "Delete a client. Its projects are kept and simply unassigned (clientId set to null) — not deleted.",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
				"responses": { "200": { "description": "OK" }, "404": { "description": "Not found" } }
			}
		},
		"/api/v1/projects/example": {
			"post": {
				"operationId": "createExampleProject",
				"summary": "Create a fully worked example project (modules, points, leaves, day hours, features, tests) so a new user can see how the tracker works without setting anything up",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }],
				"responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } } }
			}
		},
		"/api/v1/backup/export": {
			"get": {
				"operationId": "backupExport",
				"summary": "Export every project owned by the authenticated user (modules, points, leaves, day hours, features, tests) as a single JSON backup document, e.g. before migrating to a new server",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }],
				"responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "exportVersion": { "type": "integer" }, "exportedAt": { "type": "string" }, "clients": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "hourlyRate": { "type": "number", "nullable": true }, "currencySymbol": { "type": "string" } } }, "description": "Each project below references its client by name via clientName" }, "projects": { "type": "array", "items": { "type": "object" } } } } } } } }
			}
		},
		"/api/v1/backup/import": {
			"post": {
				"operationId": "backupImport",
				"summary": "Import a JSON backup document previously produced by backupExport. Always creates new projects — never overwrites or merges with existing data.",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }],
				"requestBody": {
					"required": true,
					"content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } } } }
				},
				"responses": {
					"200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "clients": { "type": "integer" }, "projects": { "type": "integer" }, "modules": { "type": "integer" }, "points": { "type": "integer" }, "leaves": { "type": "integer" }, "dayHours": { "type": "integer" }, "features": { "type": "integer" }, "tests": { "type": "integer" } } } } } },
					"400": { "description": "Missing/invalid file, or malformed backup structure" }
				}
			}
		},
		"/api/v1/projects/{id}": {
			"get": {
				"operationId": "getProject",
				"summary": "Get the fully computed project grid (estimate/done/remaining hours, per-day percentages, summary)",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
				"responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectGrid" } } } }, "404": { "description": "Not found or not owned by the authenticated user" } }
			},
			"put": {
				"operationId": "updateProject",
				"summary": "Rename a project or change its hours-per-working-day constant",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
				"requestBody": {
					"content": {
						"application/x-www-form-urlencoded": {
							"schema": {
								"type": "object",
								"properties": {
									"name": { "type": "string" },
									"hoursPerWorkingDay": { "type": "number" },
									"hourlyRate": { "type": "number", "nullable": true, "description": "only applied when hourlyRateProvided=true, so it can be explicitly cleared to null (disabling cost calculation)" },
									"hourlyRateProvided": { "type": "boolean", "default": false },
									"currencySymbol": { "type": "string" },
									"showCostInSummary": { "type": "boolean" },
									"archived": { "type": "boolean", "description": "Set to true to archive the project (hides it from the default project list without deleting anything), or false to restore it" },
									"clientId": { "type": "integer", "nullable": true, "description": "only applied when clientIdProvided=true, so it can be explicitly cleared to null (unassigning the client)" },
									"clientIdProvided": { "type": "boolean", "default": false }
								}
							}
						}
					}
				},
				"responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } }, "404": { "description": "Not found" } }
			},
			"delete": {
				"operationId": "deleteProject",
				"summary": "Delete a project and everything under it (modules, points, leaves, day-hours, features, tests)",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
				"responses": { "200": { "description": "OK" }, "404": { "description": "Not found" } }
			}
		},
		"/api/v1/projects/{projectId}/modules": {
			"post": {
				"operationId": "createModule",
				"summary": "Create a module (grouping) within a project, e.g. P1 \"Structure\"",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "projectId", "in": "path", "required": true, "schema": { "type": "integer" } }],
				"requestBody": {
					"required": true,
					"content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "required": ["code", "name"], "properties": { "code": { "type": "string" }, "name": { "type": "string" }, "inEstimate": { "type": "boolean", "default": true }, "sortOrder": { "type": "integer", "default": 0 } } } } }
				},
				"responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Module" } } } }, "404": { "description": "Project not found" } }
			}
		},
		"/api/v1/modules/{id}": {
			"put": {
				"operationId": "updateModule",
				"summary": "Update a module's code, name, in-estimate flag or sort order",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
				"requestBody": { "content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "properties": { "code": { "type": "string" }, "name": { "type": "string" }, "inEstimate": { "type": "boolean" }, "sortOrder": { "type": "integer" } } } } } },
				"responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Module" } } } }, "404": { "description": "Not found" } }
			},
			"delete": {
				"operationId": "deleteModule",
				"summary": "Delete a module and all its points and leaves",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
				"responses": { "200": { "description": "OK" }, "404": { "description": "Not found" } }
			}
		},
		"/api/v1/modules/{moduleId}/points": {
			"post": {
				"operationId": "createPoint",
				"summary": "Create an estimable point within a module, e.g. P1.1",
				"parameters": [{ "$ref": "#/components/parameters/OcsApiRequest" }, { "name": "moduleId", "in": "path", "required": true, "schema": { "type": "integer" } }],
